{
  "manifest_version": 2,
  "id": "github.hongdougao111.minimax-governor",
  "version": "1.5.1",
  "name": "MiniMax 开支管家",
  "description": "监测 MiniMax 套餐余量与回复消耗，分群独立预算，超限自动降低发言频率，支持管理员专属开关与激进/保守/均衡三档策略",
  "author": {
    "name": "hongdougao111",
    "url": "https://github.com/hongdougao111"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/hongdougao111/maibot-minimax-governor",
    "homepage": "https://github.com/hongdougao111/maibot-minimax-governor",
    "documentation": "https://github.com/hongdougao111/maibot-minimax-governor",
    "issues": "https://github.com/hongdougao111/maibot-minimax-governor/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "capabilities": ["send_message", "send.text", "chat.get_group_streams"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "dependencies": [],
  "plugin_type": "plugin"
}
